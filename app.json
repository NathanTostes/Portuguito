{
  "expo": {
    "name": "Portuguito",
    "slug": "portuguito",
    "version": "5.0.4",
    "orientation": "portrait",
    "icon": "./assets/portuguitaBase.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Portuguito"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/portuguitaBase.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.Portuguito",
      "versionCode": 24
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6e6393aa-0522-47d0-8948-86eb8ac7b851"
      }
    }
  }
}
